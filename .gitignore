# ── Environment secrets — NEVER commit these ──────────────────────────────
.env
.env.local
.env.production
.env.staging
**/.env
**/.env.local
**/.env.production

# ── Uploads / temp files ────────────────────────────────────────────────────
backend/uploads/

# ── Node modules ────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build outputs ───────────────────────────────────────────────────────────
backend/dist/
frontend/dist/

# ── Prisma SQLite dev DB (don't commit dev data) ────────────────────────────
backend/prisma/*.db
backend/prisma/*.db-journal

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
