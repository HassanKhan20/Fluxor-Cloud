# ─────────────────────────────────────────────────────────────────────────────
# Fluxor Cloud — Frontend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL — must NOT have a trailing slash
# Local dev:
VITE_API_URL=http://localhost:3001/api
# Production (Render / Railway / etc.):
# VITE_API_URL=https://api.fluxorcloud.com/api
