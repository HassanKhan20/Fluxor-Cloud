# ─────────────────────────────────────────────────────────────────────────────
# Fluxor Cloud — Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Node environment: "development" | "production"
NODE_ENV=development

# Server port
PORT=3001

# PostgreSQL connection string (Render / Neon / Supabase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# JWT secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# Frontend origin — used for CORS and password reset email links
FRONTEND_URL=http://localhost:5173

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Used for password reset emails.
# Steps to set up:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to: Google Account → Security → App Passwords
#   3. Create an App Password (select "Mail" + "Other")
#   4. Paste the 16-character password below (no spaces)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── AI / LLM (optional — leave blank to use rule-based fallback) ──────────────
# Get a key at: platform.openai.com
# Invoice AI and smart chat require this. Without it, both fall back gracefully.
OPENAI_API_KEY=
# Optional: override model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Optional: use a compatible API (e.g. Groq, Azure OpenAI)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Voice assistant (Groq for STT + LLM, ElevenLabs for TTS) ──────────────────
# Groq: https://console.groq.com/keys
# Used for: Whisper transcription (whisper-large-v3-turbo) + Llama 3.3 tool calls
GROQ_API_KEY=
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys (optional —
# without it, the assistant returns text only and the browser falls back
# to the built-in speech synth)
ELEVENLABS_API_KEY=
# Optional: override the voice. Default is "Sarah" (calm, warm).
# Browse: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=

# ── Demo account (optional) ───────────────────────────────────────────────────
# Created on first server start if both vars are set. Remove in production.
DEMO_EMAIL=demo@fluxor.cloud
DEMO_PASSWORD=REPLACE_WITH_STRONG_DEMO_PASSWORD
